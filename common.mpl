# common.mpl -- 論文の例と共通の設定
read "svdlift.mpl":
read "appgcd.mpl":
with(LinearAlgebra):
Digits := 15:
interface(warnlevel = 0):
SRC := "\\tablesource{Maple 2025, \\texttt{Digits}=15}":

# Example 1 / 2 （論文 2.1 節, 3 節）
C26 := x^3 + (1 + t2 - 2*t1 + t1^2)*x + 3:
A26 := x^3 + (t2^2 + t1 + t2 - 2)*x^2 - 1:
B26 := x^3 + (2*t2^2 - t1 + 3)*x^2 - 1:
Ex2 := proc(d1, d2)
  local L1, L2, At, Bt;
  L1 := x - d1 + 2*t2 - t1^2;
  L2 := x - d2 + t1 + t2 + t1*t2;
  At := expand(A26*L1); Bt := expand(B26*L2);
  return expand(At*C26), expand(Bt*C26), At, Bt;
end proc:

# 表の書き出し
OpenTab := proc(name, header)
  local fd;
  fd := fopen(cat("tables/", name), WRITE, TEXT);
  fprintf(fd, "%% generated by Maple (experiments/%s)\n", name);
  fprintf(fd, "%s", header);
  return fd;
end proc:
# 論文フォルダ（paper-full-multsvd.tex が \input する場所）
# 環境変数 MULTSVD_PAPERTAB にフォルダ（末尾 / 付き）を指定すると、そこにも表を複製する。未指定なら複製しない。
PAPERTAB := getenv("MULTSVD_PAPERTAB"):
if PAPERTAB = NULL or PAPERTAB = "" then PAPERTAB := "/nonexistent/" end if:
CloseTab := proc(fd, name)
  fprintf(fd, "\\hline\n\\end{tabular}\\\\[2pt]\n%s\n", SRC);
  fclose(fd);
  if FileTools:-Exists(PAPERTAB) then
    if FileTools:-Exists(cat(PAPERTAB, name)) then FileTools:-Remove(cat(PAPERTAB, name)) end if;
    FileTools:-Copy(cat("tables/", name), cat(PAPERTAB, name));
  end if;
end proc:
Median := proc(L) Statistics:-Median(Vector(map(evalf, L))) end proc:
